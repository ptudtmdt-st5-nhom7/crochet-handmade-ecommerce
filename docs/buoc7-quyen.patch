 /* Trạng thái ẩn do JavaScript điều khiển phải thắng bố cục grid/flex. */
 [hidden] { display: none !important; }
+
+/* ===== 10. BUOI 3 - QUYEN: DIEU KHIEN VA CHON QUA ===== */
