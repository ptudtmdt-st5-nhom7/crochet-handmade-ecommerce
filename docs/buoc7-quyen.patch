+.cart-line__information { overflow-wrap:anywhere; }
+.cart-gift-items { grid-template-columns:repeat(2,minmax(0,1fr)); }
+.cart-gift-item { min-width:0; }
+[data-cart-summary] p { flex-wrap:wrap; }
+[data-cart-summary] strong { overflow-wrap:anywhere; }
+.detail-error { margin-block:40px; padding:28px; border:1px solid var(--border); border-radius:16px; background:var(--surface); }
+.detail-error p { margin-block:16px; }
+.quantity-control { gap:10px; }
+.quantity-control button { min-width:44px; min-height:44px; }
+.detail-quantity-field { margin-bottom:16px; }
+#product-quantity { min-height:44px; }
+button:focus-visible, input:focus-visible, select:focus-visible, a:focus-visible { outline:3px solid #245C52; outline-offset:3px; }
+@media (max-width:1099px) {
+ .header-caption { display:none; }
+ .header-top { gap:20px; }
+ .site-nav { gap:8px 20px; }
+}
+@media (max-width:699px) {
+ .product-filter-fields, .cart-gift-items { grid-template-columns:minmax(0,1fr); }
+ .search-inner { align-items:stretch; gap:8px; }
+ .search-inner > label, .search-control, #search-note { width:100%; }
+ .search-control { flex-basis:100%; }
+ .search-control input { padding:10px 12px; }
+ .search-control button { padding:10px 14px; }
+ .site-nav { gap:4px 14px; }
+ .site-nav a { font-size:14px; }
+ .cart-line { grid-template-columns:minmax(0,1fr); padding:18px; }
+ .cart-line__image { width:100%; height:220px; }
+ .cart-line__copy, [data-cart-action="remove"] { width:100%; margin-right:0; }
+ .detail-error { padding:20px; }
+}
